 #include "dxvk_device.h"
 
 namespace dxvk {
@@ -41,6 +42,123 @@ namespace dxvk {
   }
 
 
+  VkBuffer DxvkUnboundResources::nullBufferHandle() {
+    return bufferInfo().buffer;
+  }
+
+
+  DxvkLegacyDescriptor DxvkUnboundResources::nullLegacyDescriptor(VkDescriptorType type, VkImageViewType viewType) {
+    DxvkLegacyDescriptor result = { };
+
+    switch (type) {
+      case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER:
+      case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER: {
+        auto info = bufferInfo();
+        result.buffer.buffer = info.buffer;
+        result.buffer.offset = info.offset;
+        result.buffer.range = info.size;
+      } break;
+
+      case VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER:
+      case VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER:
+      case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:
+      case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE: {
+        if (unlikely(!m_viewsCreated.load())) {
+          // The dummy buffer takes m_mutex itself, so create it first.
+          bufferInfo();
+          std::lock_guard lock(m_mutex);
+
+          if (!m_viewsCreated.load()) {
+            createViews();
+            m_viewsCreated.store(true);
+          }
+        }
+
+        bool storage = type == VK_DESCRIPTOR_TYPE_STORAGE_IMAGE || type == VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER;
+
+        if (type == VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER || type == VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER) {
+          result = m_bufferViews[storage]->getDescriptor(false)->legacy;
+        } else {
+          uint32_t index = uint32_t(viewType) < 7u ? uint32_t(viewType) : uint32_t(VK_IMAGE_VIEW_TYPE_2D);
+          result = m_imageViews[storage][index]->getDescriptor(VkImageViewType(index))->legacy;
+        }
+      } break;
+
+      default:
+        break;
+    }
+
+    return result;
+  }
+
+
+  void DxvkUnboundResources::createViews() {
+    auto makeImage = [this] (VkImageType type, uint32_t layers, VkImageCreateFlags flags) {
+      DxvkImageCreateInfo info;
+      info.type         = type;
+      info.format       = VK_FORMAT_R8G8B8A8_UNORM;
+      info.flags        = flags;
+      info.sampleCount  = VK_SAMPLE_COUNT_1_BIT;
+      info.extent       = { 1u, 1u, 1u };
+      info.numLayers    = layers;
+      info.mipLevels    = 1u;
+      info.usage        = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+      info.stages       = VK_PIPELINE_STAGE_TRANSFER_BIT | m_device->getShaderPipelineStages();
+      info.access       = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+      info.layout       = VK_IMAGE_LAYOUT_GENERAL;
+      info.debugName    = "Null image";
+      return m_device->createImage(info, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+    };
+
+    m_images[0] = makeImage(VK_IMAGE_TYPE_1D, 1u, 0u);
+    m_images[1] = makeImage(VK_IMAGE_TYPE_2D, 6u, VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT);
+    m_images[2] = makeImage(VK_IMAGE_TYPE_3D, 1u, 0u);
+
+    static const std::array<std::pair<uint32_t, uint32_t>, 7> viewSetup = {{
+      { 0u, 1u },   // 1D
+      { 1u, 1u },   // 2D
+      { 2u, 1u },   // 3D
+      { 1u, 6u },   // CUBE
+      { 0u, 1u },   // 1D_ARRAY
+      { 1u, 1u },   // 2D_ARRAY
+      { 1u, 6u },   // CUBE_ARRAY
+    }};
+
+    for (uint32_t storage = 0u; storage < 2u; storage++) {
+      for (uint32_t i = 0u; i < viewSetup.size(); i++) {
+        DxvkImageViewKey key;
+        key.viewType    = VkImageViewType(i);
+        key.usage       = storage ? VK_IMAGE_USAGE_STORAGE_BIT : VK_IMAGE_USAGE_SAMPLED_BIT;
+        key.format      = VK_FORMAT_R8G8B8A8_UNORM;
+        key.layout      = VK_IMAGE_LAYOUT_GENERAL;
+        key.aspects     = VK_IMAGE_ASPECT_COLOR_BIT;
+        key.mipIndex    = 0u;
+        key.mipCount    = 1u;
+        key.layerIndex  = 0u;
+        key.layerCount  = uint16_t(viewSetup[i].second);
+        m_imageViews[storage][i] = m_images[viewSetup[i].first]->createView(key);
+      }
+
+      DxvkBufferViewKey bufferKey;
+      bufferKey.format  = VK_FORMAT_R32_UINT;
+      bufferKey.usage   = storage ? VK_BUFFER_USAGE_STORAGE_TEXEL_BUFFER_BIT : VK_BUFFER_USAGE_UNIFORM_TEXEL_BUFFER_BIT;
+      bufferKey.offset  = 0u;
+      bufferKey.size    = 4096u;
+
+      m_bufferViews[storage] = m_buffer->createView(bufferKey);
+    }
+
+    // Transition to GENERAL and clear to zero once.
+    Rc<DxvkContext> ctx = m_device->createContext();
+    ctx->beginRecording(m_device->createCommandList());
+
+    for (const auto& image : m_images)
+      ctx->initImage(image, VK_IMAGE_LAYOUT_UNDEFINED);
+
+    ctx->flushCommandList(nullptr, nullptr);
+  }
+
+
   Rc<DxvkSampler> DxvkUnboundResources::createSampler() {
     DxvkSamplerKey info;
     info.setFilter(VK_FILTER_LINEAR, VK_FILTER_LINEAR, VK_SAMPLER_MIPMAP_MODE_LINEAR);
