 namespace dxvk::wsi {
 
+#if defined(__APPLE__)
+  // Cocoa/UIKit only allow window changes (and Metal view creation) on the
+  // main thread, while DXVK runs on the application's render thread. These
+  // wrappers marshal those calls with SDL_RunOnMainThread.
+  namespace {
+    using RunOnMainFn = bool (SDLCALL *)(void (SDLCALL *)(void*), void*, bool);
+    using IsMainFn    = bool (SDLCALL *)(void);
+    RunOnMainFn g_runOnMain = nullptr;
+    IsMainFn    g_isMain    = nullptr;
+
+    template<typename F>
+    void onMain(F&& f) {
+      if (!g_runOnMain || !g_isMain || g_isMain()) {
+        f();
+        return;
+      }
+      g_runOnMain([] (void* p) { (*static_cast<F*>(p))(); }, &f, true);
+    }
+
+    bool (SDLCALL *rawSetWindowSize)(SDL_Window*, int, int);
+    bool (SDLCALL *rawSetWindowPosition)(SDL_Window*, int, int);
