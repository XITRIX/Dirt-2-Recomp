+    bool (SDLCALL *rawCreateSurface)(SDL_Window*, VkInstance, const VkAllocationCallbacks*, VkSurfaceKHR*);
+
+    bool SDLCALL mainSetWindowSize(SDL_Window* w, int x, int y) {
+      bool r = false; onMain([&] { r = rawSetWindowSize(w, x, y); }); return r;
+    }
+    bool SDLCALL mainSetWindowPosition(SDL_Window* w, int x, int y) {
+      bool r = false; onMain([&] { r = rawSetWindowPosition(w, x, y); }); return r;
+    }
+    bool SDLCALL mainSetWindowFullscreen(SDL_Window* w, bool f) {
+      bool r = false; onMain([&] { r = rawSetWindowFullscreen(w, f); }); return r;
+    }
+    bool SDLCALL mainSetWindowFullscreenMode(SDL_Window* w, const SDL_DisplayMode* m) {
+      bool r = false; onMain([&] { r = rawSetWindowFullscreenMode(w, m); }); return r;
+    }
+    bool SDLCALL mainCreateSurface(SDL_Window* w, VkInstance i, const VkAllocationCallbacks* a, VkSurfaceKHR* s) {
+      bool r = false; onMain([&] { r = rawCreateSurface(w, i, a, s); }); return r;
