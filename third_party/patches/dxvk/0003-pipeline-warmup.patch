+  Rc<DxvkShader> DxvkPipelineManager::findCachedShader(
+    const std::string&                    name,
+    const DxvkIrShaderCreateInfo&         createInfo) {
+    std::lock_guard lock(m_cachedShaderMutex);
+
+    auto entry = m_cachedShaders.find(name);
+
+    if (entry == m_cachedShaders.end())
+      return nullptr;
+
+    for (const auto& shader : entry->second) {
+      if (static_cast<DxvkIrShader*>(shader.ptr())->getShaderCreateInfo().eq(createInfo))
+        return shader;
+    }
+
+    return nullptr;
+  }
+
+
+  Rc<DxvkShader> DxvkPipelineManager::addCachedShader(
+    const std::string&                    name,
+    const Rc<DxvkShader>&                 shader) {
+    auto createInfo = static_cast<DxvkIrShader*>(shader.ptr())->getShaderCreateInfo();
+
+    std::lock_guard lock(m_cachedShaderMutex);
+    auto& list = m_cachedShaders[name];
+
+    for (const auto& existing : list) {
+      if (static_cast<DxvkIrShader*>(existing.ptr())->getShaderCreateInfo().eq(createInfo))
+        return existing;
+    }
+
+    list.push_back(shader);
+    m_cachedShaderNames.insert({ shader.ptr(), name });
+    return shader;
+  }
+
+
+  bool DxvkPipelineManager::serializePipeline(
+    const DxvkGraphicsPipelineShaders&    shaders,
+    const DxvkGraphicsPipelineStateInfo&  state,
+          std::vector<uint8_t>&           payload) {
+    std::array<const Rc<DxvkShader>*, 5u> stages = {
+      &shaders.vs, &shaders.tcs, &shaders.tes, &shaders.gs, &shaders.fs };
+
+    uint8_t mask = 0u;
+
+    for (uint32_t i = 0u; i < stages.size(); i++) {
+      if (*stages[i] != nullptr)
+        mask |= 1u << i;
+    }
+
+    payload.clear();
+    putBytes(payload, mask);
+
+    std::lock_guard lock(m_cachedShaderMutex);
+
+    for (auto stage : stages) {
+      if (*stage == nullptr)
+        continue;
+
+      // Only shaders that come from the shader cache can be found again
+      auto name = m_cachedShaderNames.find(stage->ptr());
+
+      if (name == m_cachedShaderNames.end())
+        return false;
+
+      auto createInfo = static_cast<DxvkIrShader*>(stage->ptr())->getShaderCreateInfo();
+
+      if (!createInfo.xfbEntries.empty())
+        return false;
+
+      putBytes(payload, uint16_t(name->second.size()));
+      payload.insert(payload.end(), name->second.begin(), name->second.end());
+      putBytes(payload, createInfo.options);
+      putBytes(payload, createInfo.flatShadingInputs);
+      putBytes(payload, createInfo.rasterizedStream);
+    }
+
+    putBytes(payload, state);
+    return true;
+  }
+
+
+  bool DxvkPipelineManager::deserializePipeline(
+    const std::vector<uint8_t>&           payload,
+          DxvkGraphicsPipelineShaders&    shaders,
+          DxvkGraphicsPipelineStateInfo&  state) {
+    std::array<Rc<DxvkShader>*, 5u> stages = {
+      &shaders.vs, &shaders.tcs, &shaders.tes, &shaders.gs, &shaders.fs };
+
+    size_t offset = 0u;
+    uint8_t mask = 0u;
+
+    if (!getBytes(payload, offset, mask))
+      return false;
+
+    for (uint32_t i = 0u; i < stages.size(); i++) {
+      if (!(mask & (1u << i)))
+        continue;
+
+      uint16_t nameLength = 0u;
+
+      if (!getBytes(payload, offset, nameLength) || offset + nameLength > payload.size())
+        return false;
+
+      std::string name(reinterpret_cast<const char*>(&payload[offset]), nameLength);
+      offset += nameLength;
+
+      DxvkIrShaderCreateInfo createInfo = { };
+
+      if (!getBytes(payload, offset, createInfo.options)
+       || !getBytes(payload, offset, createInfo.flatShadingInputs)
+       || !getBytes(payload, offset, createInfo.rasterizedStream))
+        return false;
+
+      // Goes through the shader cache and registers the shader, so that
+      // the application gets the very same object when it asks for it.
+      *stages[i] = m_device->createCachedShader(name, createInfo, nullptr);
+
+      if (*stages[i] == nullptr)
+        return false;
+    }
+
+    return getBytes(payload, offset, state)
+        && offset == payload.size()
+        && shaders.validate();
+  }
+
+
+  void DxvkPipelineManager::initPipelineFiles() {
+    std::string recordPath = env::getEnvVar("DXVK_PIPELINE_RECORD");
+    std::string warmUpPaths = env::getEnvVar("DXVK_PIPELINE_WARMUP");
+    m_timeDrawCompiles = env::getEnvVar("DXVK_PIPELINE_TIMING") == "1";
+
+    std::vector<uint64_t> checksums;
+    size_t pathStart = 0u;
+
+    while (pathStart < warmUpPaths.size()) {
+      size_t pathEnd = warmUpPaths.find(':', pathStart);
+
+      if (pathEnd == std::string::npos)
+        pathEnd = warmUpPaths.size();
+
+      std::string path = warmUpPaths.substr(pathStart, pathEnd - pathStart);
+      pathStart = pathEnd + 1u;
+
+      std::vector<uint8_t> data;
+
+      if (path.empty() || !readWholeFile(path, data))
+        continue;
+
+      size_t count = m_warmUpEntries.size();
+
+      if (!parsePipelineFile(data, m_warmUpEntries, checksums)) {
+        Logger::warn(str::format("DXVK: Pipeline file ", path, " is from another DXVK build, ignored"));
+        continue;
+      }
+
+      Logger::info(str::format("DXVK: Pipeline file ", path, ": ", m_warmUpEntries.size() - count, " pipelines"));
+    }
+
+    // The same pipeline may be listed in several files
+    std::vector<std::vector<uint8_t>> entries;
+
+    for (size_t i = 0u; i < m_warmUpEntries.size(); i++) {
+      if (m_knownPipelines.insert(checksums[i]).second)
+        entries.push_back(std::move(m_warmUpEntries[i]));
+    }
+
+    m_warmUpEntries = std::move(entries);
+
+    if (!recordPath.empty()) {
+      // Keep what is already recorded, minus a torn last entry
+      std::vector<uint8_t> data;
+      std::vector<std::vector<uint8_t>> payloads;
+      std::vector<uint64_t> recorded;
+
+      size_t validSize = readWholeFile(recordPath, data)
+        ? parsePipelineFile(data, payloads, recorded) : 0u;
+
+      for (uint64_t checksum : recorded)
+        m_knownPipelines.insert(checksum);
+
+      if (validSize && validSize == data.size()) {
+        m_recordFile = std::fopen(recordPath.c_str(), "ab");
+      } else if ((m_recordFile = std::fopen(recordPath.c_str(), "wb"))) {
+        if (validSize) {
+          std::fwrite(data.data(), 1u, validSize, m_recordFile);
+        } else {
+          PipelineFileHeader header = makePipelineFileHeader();
+          std::fwrite(&header, 1u, sizeof(header), m_recordFile);
+        }
+
+        std::fflush(m_recordFile);
+      }
+
+      if (m_recordFile)
+        Logger::info(str::format("DXVK: Recording pipelines to ", recordPath, " (", recorded.size(), " so far)"));
+      else
+        Logger::warn(str::format("DXVK: Failed to open ", recordPath, " for recording pipelines"));
+    }
+
+    if (!m_warmUpEntries.empty())
+      m_warmUpThread = dxvk::thread([this] { runWarmUp(); });
+  }
+
+
+  void DxvkPipelineManager::recordGraphicsPipeline(
+    const DxvkGraphicsPipelineShaders&    shaders,
+    const DxvkGraphicsPipelineStateInfo&  state) {
+    std::vector<uint8_t> payload;
+
+    if (!serializePipeline(shaders, state, payload)) {
+      std::lock_guard lock(m_recordMutex);
+
+      if (!(m_recordSkipped++))
+        Logger::info("DXVK: Not recording pipelines with shaders that are not in the shader cache");
+      return;
+    }
+
+    uint64_t checksum = bit::fnv1a_hash(payload.data(), payload.size());
+
+    std::lock_guard lock(m_recordMutex);
+
+    if (!m_recordFile || !m_knownPipelines.insert(checksum).second)
+      return;
+
+    uint32_t size = uint32_t(payload.size());
+    std::fwrite(&size, 1u, sizeof(size), m_recordFile);
+    std::fwrite(&checksum, 1u, sizeof(checksum), m_recordFile);
+    std::fwrite(payload.data(), 1u, payload.size(), m_recordFile);
+    std::fflush(m_recordFile);
+  }
+
+
+  void DxvkPipelineManager::logDrawCompile(std::chrono::steady_clock::duration time) {
+    uint64_t us = std::chrono::duration_cast<std::chrono::microseconds>(time).count();
+    uint32_t count = ++m_drawCompiles;
+    uint64_t total = (m_drawCompileUs += us);
+
+    Logger::info(str::format("DXVK: Pipeline compiled at draw: ", us / 1000.0, " ms (",
+      count, " so far, ", total / 1000u, " ms total)"));
+  }
+
+
+  void DxvkPipelineManager::runWarmUp() {
+    env::setThreadName("dxvk-warmup");
+
+    auto start = std::chrono::steady_clock::now();
+    uint32_t queued = 0u;
+    uint32_t skipped = 0u;
+
+    m_workers.beginWarmUp();
+
+    for (const auto& payload : m_warmUpEntries) {
+      if (m_warmUpStop.load())
+        break;
+
+      DxvkGraphicsPipelineShaders shaders;
+      DxvkGraphicsPipelineStateInfo state;
+
+      if (!deserializePipeline(payload, shaders, state)) {
+        skipped += 1u;
+        continue;
+      }
+
+      m_workers.compileWarmUpPipeline(createGraphicsPipeline(shaders), state);
+      queued += 1u;
+    }
+
+    auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+      std::chrono::steady_clock::now() - start).count();
+
+    Logger::info(str::format("DXVK: Pipeline warm-up: queued ", queued, " pipelines in ", ms, " ms",
+      skipped ? str::format(", skipped ", skipped, " (shaders not in the shader cache)") : std::string()));
+
+    m_warmUpEntries.clear();
+    m_warmUpEntries.shrink_to_fit();
+    m_workers.endWarmUp();
+  }
+
 }
