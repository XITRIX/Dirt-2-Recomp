+  /*
+   * Pipeline record and warm-up files
+   *
+   * Without graphics pipeline libraries, every new combination of shaders
+   * and state compiles synchronously at its first draw. A record file lists
+   * the pipelines an application used; warming up compiles them on the worker
+   * threads before they are needed. The shaders come from the shader cache,
+   * so a file is only useful together with the cache it was recorded with.
+   *
+   * File: header, then entries of { u32 size, u64 fnv1a(payload), payload }.
+   * Payload: u8 stage mask (vs, tcs, tes, gs, fs), per stage { u16 name
+   * length, name, DxvkShaderOptions, u32 flat shading inputs, i32 rasterized
+   * stream }, then the raw DxvkGraphicsPipelineStateInfo, which is compared
+   * and hashed bytewise anyway. A torn last entry is dropped.
+   */
+  namespace {
+
+    struct PipelineFileHeader {
+      char      magic[4];
+      uint32_t  format;
+      uint32_t  optionsSize;
+      uint32_t  stateSize;
+      char      version[64];
+    };
+
+    constexpr uint32_t PipelineFileFormat = 1u;
+
+    PipelineFileHeader makePipelineFileHeader() {
+      PipelineFileHeader header = { };
+      std::memcpy(header.magic, "D2PL", 4u);
+      header.format = PipelineFileFormat;
+      header.optionsSize = sizeof(DxvkShaderOptions);
+      header.stateSize = sizeof(DxvkGraphicsPipelineStateInfo);
+      std::strncpy(header.version, DXVK_VERSION, sizeof(header.version) - 1u);
+      return header;
+    }
+
+    bool readWholeFile(const std::string& path, std::vector<uint8_t>& data) {
+      std::FILE* file = std::fopen(path.c_str(), "rb");
+
+      if (!file)
+        return false;
+
+      uint8_t buffer[65536];
+      size_t count;
+
+      while ((count = std::fread(buffer, 1u, sizeof(buffer), file)))
+        data.insert(data.end(), buffer, buffer + count);
+
+      std::fclose(file);
+      return true;
+    }
+
+    /* Parses a pipeline file. Returns the number of bytes that hold a valid
+     * header and complete entries, or 0 if the header does not match. */
+    size_t parsePipelineFile(
+      const std::vector<uint8_t>&               data,
+            std::vector<std::vector<uint8_t>>&  payloads,
+            std::vector<uint64_t>&              checksums) {
+      PipelineFileHeader expected = makePipelineFileHeader();
+
+      if (data.size() < sizeof(expected) || std::memcmp(data.data(), &expected, sizeof(expected)))
+        return 0u;
+
+      size_t offset = sizeof(expected);
+
+      while (offset + 12u <= data.size()) {
+        uint32_t size;
+        uint64_t checksum;
+        std::memcpy(&size, &data[offset], 4u);
+        std::memcpy(&checksum, &data[offset + 4u], 8u);
+
+        if (offset + 12u + size > data.size()
+         || bit::fnv1a_hash(&data[offset + 12u], size) != checksum)
+          break;
+
+        payloads.emplace_back(data.begin() + offset + 12u, data.begin() + offset + 12u + size);
+        checksums.push_back(checksum);
+        offset += 12u + size;
+      }
+
+      return offset;
+    }
+
+    template<typename T>
+    void putBytes(std::vector<uint8_t>& out, const T& value) {
+      auto bytes = reinterpret_cast<const uint8_t*>(&value);
+      out.insert(out.end(), bytes, bytes + sizeof(value));
+    }
+
+    template<typename T>
+    bool getBytes(const std::vector<uint8_t>& in, size_t& offset, T& value) {
+      if (offset + sizeof(value) > in.size())
+        return false;
+
+      std::memcpy(reinterpret_cast<void*>(&value), &in[offset], sizeof(value));
+      offset += sizeof(value);
+      return true;
+    }
+
+  }
