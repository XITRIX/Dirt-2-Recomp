diff --git a/src/d3d11/d3d11_pipeline_warmup.cpp b/src/d3d11/d3d11_pipeline_warmup.cpp
new file mode 100644
index 0000000..16acf03
--- /dev/null
+++ b/src/d3d11/d3d11_pipeline_warmup.cpp
@@ -0,0 +1,27 @@
+#include "d3d11_pipeline_warmup.hpp"
+#include "log/log.hpp"
+#include "util_env.hpp"
+#include <mutex>
+
+namespace dxmt {
+
+void wait_pipeline_logged(std::atomic_bool &ready, const char *kind) {
+  static const bool timing = env::getEnvVar("DXMT_PIPELINE_TIMING") == "1";
+  if (!timing) {
+    ready.wait(false, std::memory_order_acquire);
+    return;
+  }
+  const auto t0 = std::chrono::steady_clock::now();
+  ready.wait(false, std::memory_order_acquire);
+  const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+  static std::mutex mu;
+  static unsigned count = 0;
+  static double total = 0;
+  std::lock_guard lk(mu);
+  ++count;
+  total += ms;
+  Logger::info(str::format("Pipeline wait at draw (", kind, "): ", ms, " ms (", count, " so far, ", total,
+                           " ms total)"));
+}
+
+} // namespace dxmt
diff --git a/src/d3d11/d3d11_pipeline_warmup.hpp b/src/d3d11/d3d11_pipeline_warmup.hpp
new file mode 100644
index 0000000..3c9ce69
--- /dev/null
+++ b/src/d3d11/d3d11_pipeline_warmup.hpp
@@ -0,0 +1,29 @@
+#pragma once
+/*
+ * Pipeline record and warm-up (DiRT 2 recompilation, dxmt/0004).
+ *
+ * Metal compiles a pipeline the first time a draw needs it; the draw then
+ * waits (stutter). DXMT_PIPELINE_RECORD=<file> appends every new pipeline
+ * (shader SHA-1s, input layout, blend, render target formats and the other
+ * state the pipeline is keyed on) to a file; DXMT_PIPELINE_WARMUP=<file>[:...]
+ * loads such files, and as soon as all shaders of a recorded pipeline exist
+ * (the game creates them while loading) the pipeline is queued on DXMT's
+ * compiler threads, so the draw finds it ready. DXMT_PIPELINE_TIMING=1 logs
+ * every draw that had to wait for a pipeline: the stutter metric.
+ */
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+namespace dxmt {
+
+// Waits for a pipeline compile; with DXMT_PIPELINE_TIMING=1 logs the wait.
+void wait_pipeline_logged(std::atomic_bool &ready, const char *kind);
+
+inline void wait_pipeline(std::atomic_bool &ready, const char *kind) {
+  if (ready.load(std::memory_order_acquire))
+    return;
+  wait_pipeline_logged(ready, kind);
+}
+
+} // namespace dxmt
