+      if (std::FILE *f = std::fopen(path.c_str(), "rb")) {
+        WarmupHeader h{};
+        fresh = !(std::fread(&h, sizeof h, 1, f) == 1 && !std::memcmp(h.magic, "DXPW", 4) &&
+                  h.version == kWarmVersion && h.record_size == sizeof(WarmupRecord));
+        std::fclose(f);
+      }
+      record_file_ = std::fopen(path.c_str(), fresh ? "wb" : "ab");
+      if (record_file_ && fresh) {
+        WarmupHeader h{{'D', 'X', 'P', 'W'}, kWarmVersion, (uint32_t)sizeof(WarmupRecord), 0};
+        std::fwrite(&h, sizeof h, 1, record_file_);
+        std::fflush(record_file_);
+      }
+    }
+  }
