+        } else {
+          Logger::warn(str::format("Pipeline warm-up: ", file, " is from another DXMT build, ignored"));
+        }
+        std::fclose(f);
+      }
+    }
+    if (auto path = env::getEnvVar("DXMT_PIPELINE_RECORD"); !path.empty()) {
