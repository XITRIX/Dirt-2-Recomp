+} // namespace dxmt
+
+extern "C" __attribute__((visibility("default"))) void
+dxmt_set_spatial_upscale(int enabled, uint32_t width, uint32_t height) {
+  auto &t = dxmt::g_native_upscale;
+  if (t.enabled.load() == !!enabled && t.width.load() == width && t.height.load() == height)
+    return;
+  t.width.store(width);
+  t.height.store(height);
+  t.enabled.store(!!enabled);
+  t.generation.fetch_add(1);
+}
