+#if MVK_XCODE_16
+void MVKDevice::removeResidency(id<MTLAllocation> allocation) {
+	if ( !_residencySet || !allocation ) { return; }
+
+	// Command buffers on a queue complete in order, so an empty marker command buffer
+	// completing on every queue means nothing submitted before it still uses the allocation.
+	MVKSmallVector<id<MTLCommandQueue>, kMVKQueueCountPerQueueFamily> mtlQueues;
+	for (auto& queues : _queuesByQueueFamilyIndex) {
+		for (MVKQueue* q : queues) {
+			if (q && q->getMTLCommandQueue()) { mtlQueues.push_back(q->getMTLCommandQueue()); }
+		}
+	}
+
+	id<MTLResidencySet> residencySet = [_residencySet retain];
+	[allocation retain];
+	if (mtlQueues.empty()) {
+		@synchronized(residencySet) {
+			[residencySet removeAllocation: allocation];
+			[residencySet commit];
+		}
+		[allocation release];
+		[residencySet release];
+		return;
+	}
+
+	auto* pending = new std::atomic<size_t>(mtlQueues.size());
+	for (id<MTLCommandQueue> mtlQueue : mtlQueues) {
+		@autoreleasepool {
+			auto release = ^{
+				if (pending->fetch_sub(1) != 1) { return; }
+				delete pending;
+				@synchronized(residencySet) {
+					[residencySet removeAllocation: allocation];
+					[residencySet commit];
+				}
+				[allocation release];
+				[residencySet release];
+			};
+			id<MTLCommandBuffer> mtlCmdBuff = [mtlQueue commandBufferWithUnretainedReferences];
+			if ( !mtlCmdBuff ) { release(); continue; }
+			[mtlCmdBuff addCompletedHandler: ^(id<MTLCommandBuffer> mcb) { release(); }];
+			[mtlCmdBuff commit];
+		}
+	}
+}
+#endif
