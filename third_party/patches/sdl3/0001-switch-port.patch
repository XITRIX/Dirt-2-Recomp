+  3. This notice may not be removed or altered from any source distribution.
+*/
+#include "SDL_internal.h"
+
+#ifdef SDL_FILESYSTEM_SWITCH
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+/* System dependent filesystem routines                                */
+
+#include <limits.h>
+#include <sys/unistd.h>
+
+char *SDL_SYS_GetExeName(void)
+{
+    return NULL;  // like the other consoles: there is no executable name to report.
+}
+
+char *SDL_SYS_GetBasePath(void)
+{
+    char *base_path = SDL_strdup("romfs:/");
+    return base_path;
+}
+
+char *SDL_SYS_GetPrefPath(const char *org, const char *app)
+{
+    char *ret = NULL;
+    char buf[PATH_MAX];
+    size_t len;
+
+    if (getcwd(buf, PATH_MAX)) {
+        len = strlen(buf) + 2;
+        ret = (char *)SDL_malloc(len);
+        if (!ret) {
+            SDL_OutOfMemory();
+            return NULL;
+        }
+        SDL_snprintf(ret, len, "%s/", buf);
+        return ret;
+    }
+
+    return NULL;
+}
+
+char *SDL_SYS_GetUserFolder(SDL_Folder folder)
+{
+    SDL_Unsupported();
+    return NULL;
+}
+
+#endif /* SDL_FILESYSTEM_SWITCH */
+
