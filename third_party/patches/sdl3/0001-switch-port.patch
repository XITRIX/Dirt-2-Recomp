+/* Function to perform any system-specific joystick related cleanup */
+static void SWITCH_JoystickQuit(void)
+{
+    for (int i = 0; i < JOYSTICK_COUNT; ++i) {
+        SDL_PrivateJoystickRemoved(SWITCH_JoystickGetDeviceInstanceID(i));
+    }
+}
