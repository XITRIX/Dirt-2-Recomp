+            uint32 projected = spv_bumpid(ctx);
+            push_output(ctx, &ctx->mainline);
+            spv_emit(ctx, 5, SpvOpFDiv, vec4_tid, projected, texcoord, divisor);
+            pop_output(ctx);
+            texcoord = projected;
