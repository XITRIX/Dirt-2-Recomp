{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Ninja"
    },
    {
      "name": "macos-arm64",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "macos-debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "macos-tests",
      "inherits": "macos-arm64",
      "cacheVariables": { "DIRT2_BUILD_TESTS": "ON" }
    },
    {
      "name": "ios",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "16.0",
        "DIRT2_BUILD_TOOLS": "OFF"
      }
    },
    {
      "name": "ios-sim",
      "inherits": "ios",
      "cacheVariables": { "CMAKE_OSX_SYSROOT": "iphonesimulator" }
    },
    {
      "name": "tvos",
      "inherits": "base",
      "generator": "Xcode",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "tvOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "DIRT2_BUILD_TOOLS": "OFF"
      }
    },
    {
      "name": "visionos",
      "inherits": "base",
      "generator": "Xcode",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "visionOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "DIRT2_BUILD_TOOLS": "OFF"
      }
    },
    {
      "name": "switch",
      "inherits": "base",
      "toolchainFile": "/opt/devkitpro/cmake/Switch.cmake",
      "environment": { "DEVKITPRO": "/opt/devkitpro" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "DIRT2_BUILD_TOOLS": "OFF"
      }
    },
    {
      "name": "linux-x64",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    }
  ],
  "buildPresets": [
    { "name": "macos-arm64", "configurePreset": "macos-arm64" },
    { "name": "macos-debug", "configurePreset": "macos-debug" },
    { "name": "macos-tests", "configurePreset": "macos-tests" },
    { "name": "ios", "configurePreset": "ios" },
    { "name": "ios-sim", "configurePreset": "ios-sim" },
    { "name": "switch", "configurePreset": "switch" }
  ],
  "testPresets": [
    { "name": "macos-tests", "configurePreset": "macos-tests", "output": { "outputOnFailure": true } }
  ]
}
